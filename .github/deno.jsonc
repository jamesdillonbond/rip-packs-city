{
  // CI-only Deno lint config for the Supabase edge functions
  // (supabase/functions/**). Referenced explicitly via `deno lint --config`
  // in the `edge-deno` CI job, and kept OUT of the functions tree on purpose
  // so `supabase functions deploy` never discovers it (a deno.json inside
  // supabase/functions could change how the CLI treats the directory).
  //
  // `no-explicit-any` is excluded because `any` is a DELIBERATE, documented
  // pattern in this codebase (CLAUDE.md: "Supabase client must be typed as
  // `any`"); flagging it would be ~95 lines of pure noise. Every other default
  // rule stays on so the gate surfaces real signal — dead code (no-unused-vars),
  // unreachable branches, missing awaits, empty blocks.
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  }
}
