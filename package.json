{
  "name": "rip-packs-city",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ratchet": "npx eslint . --format json -o /tmp/eslint-report.json || true; node scripts/check-eslint-ratchet.mjs --report /tmp/eslint-report.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:components": "vitest run --coverage --config vitest.components.config.ts",
    "test:coverage:workers": "vitest run --coverage --config vitest.workers.config.ts",
    "test:cadence": "node scripts/extract-cadence.mjs && flow cadence lint -f tests/cadence/flow.test.json tests/cadence/fixtures/purchase-moment.cdc",
    "test:cadence:escrow": "bash scripts/fetch-cadence-escrow-test-deps.sh && flow test -f cadence/tests/flow.test.json cadence/tests/RPCTradeEscrow_test.cdc",
    "db:pins:check": "node scripts/check-db-pin-staleness.mjs",
    "register:check": "node scripts/check-register-integrity.mjs",
    "pipelines:kills": "node scripts/analysis/killed-after-routes.mjs",
    "edge:drift:check": "node scripts/check-edge-fn-drift.mjs",
    "classify:dapper": "node scripts/dapper-csv-classify.mjs",
    "classify:ts-livetoken": "node scripts/classify-ts-livetoken.mjs",
    "seed:usernames": "tsx scripts/seed-wallet-usernames.ts",
    "db:migrations:check": "node scripts/check-migration-parity.mjs",
    "db:migrations:recover": "node scripts/recover-fileless-migrations.mjs",
    "skills:bundles:check": "node scripts/check-cowork-skill-bundles.mjs",
    "skills:pack": "node scripts/pack-cowork-skill.mjs",
    "memory:retired:check": "node scripts/check-retired-rules.mjs",
    "inbox:index:fix": "node scripts/fix-inbox-index-counts.mjs",
    "inbox:index:check": "node scripts/fix-inbox-index-counts.mjs --check",
    "docs:issues-index": "node scripts/gen-known-issues-index.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "@onflow/fcl": "^1.21.9",
    "@onflow/react-sdk": "^0.20.0",
    "@onflow/types": "^1.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "^10.50.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.95.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "csv-parse": "^5.6.0",
    "elliptic": "^6.6.1",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.11.0",
    "next": "16.2.9",
    "oauth-1.0a": "^2.2.6",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "sha3": "^2.1.4",
    "stripe": "^22.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@deno/eszip": "^0.106.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/elliptic": "^6.4.18",
    "@types/node": "^24",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
