# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://bxcqstmqfzmuolpuynti.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Flow Blockchain ──────────────────────────────────────────────────────────
NEXT_PUBLIC_FLOW_NETWORK=mainnet

# ─── Site URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.rippackscity.com
NEXT_PUBLIC_APP_URL=https://www.rippackscity.com

# ─── AI Concierge (Claude Sonnet) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Cron / Pipeline Auth ─────────────────────────────────────────────────────
INGEST_SECRET_TOKEN=your-ingest-secret
CRON_SECRET=your-cron-secret

# ─── Admin Console (/admin/* + /api/admin/*) ──────────────────────────────────
# Gates every admin tool (lib/admin-auth.ts, deny-by-default: unset ⇒ all
# admin API routes 401). Pasted into each dashboard's token prompt and sent as
# `Authorization: Bearer <RPC_ADMIN_TOKEN>`.
RPC_ADMIN_TOKEN=your-admin-token

# ─── Top Shot Proxy (Cloudflare Worker) ────────────────────────────────────────
TS_PROXY_URL=https://your-worker.workers.dev
TS_PROXY_SECRET=your-proxy-secret

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
ALERT_EMAIL=alerts@rippackscity.com
# Optional sender overrides — default to the verified apex domain
# (noreply@rippackscity.com). Only set to change the From display name/address;
# never point these at the onboarding@resend.dev sandbox sender.
# RPC_OPS_FROM="RPC Ops <noreply@rippackscity.com>"
# RPC_ALERTS_FROM="RPC Alerts <noreply@rippackscity.com>"

# ─── Telegram Sentinel Bot (OPS alerts → Trevor) ──────────────────────────────
# System B: sentinel/check-alerts/concierge-escalation health pages.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ─── User-alert delivery (System A: deal/FMV subscriptions → subscribers) ──────
# Separate bot from the sentinel above — drives /api/cron/alerts-send +
# /api/bots/*. If TELEGRAM_USER_BOT_TOKEN is unset, every Telegram delivery in
# the outbox is marked failed and re-queued until it dies (attempts>=5).
TELEGRAM_USER_BOT_TOKEN=your-user-facing-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
DISCORD_BOT_TOKEN=your-discord-bot-token

# ─── OpenSea (Panini collection — optional) ───────────────────────────────────
OPENSEA_API_KEY=your-opensea-api-key

# ─── Sentry (error tracking) ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=rip-packs-city

# ─── Stripe (RPC Pro subscriptions) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_FLOWTY_MARKET_PROBES=true
ENABLE_TOPSHOT_DOCS_PROBES=true
MARKET_FEED_TOKEN=your-market-feed-token

# ─── Fast Break optimizer ─────────────────────────────────────────────────────
# Captain-points weighting for /api/fast-break/optimize. Top Shot scores the
# Captain higher than the rest of the lineup; this multiplier boosts the chosen
# lineup's top scorer in both selection and projectedScore. Unset ⇒ 1.0 ⇒ no
# weighting (safe default). Clamped to [1, 3]. Calibrate once observed Run
# scoring is regressed on (sum_of_proj_points, captain_proj_points).
# FAST_BREAK_CAPTAIN_MULTIPLIER=1.0

# Local-only, for scripts/local-cost-basis-backfill.mjs (Dapper session).
# NEVER paste these into the script itself — it is tracked, and that exact
# workflow leaked live session cookies and forced the 2026-08-03 history rewrite.
DAPPER_COOKIE=
DAPPER_X_ID_TOKEN=
