# dependencies
node_modules/
/.pnp
.pnp.js

# next.js
/.next/
/out/
# Ignore any leaf files under app/out/ (legacy static-export artifacts) but
# keep the Next.js route handler tree. Git can't un-ignore a file whose
# parent directory is ignored, so we excluded directories instead of the
# directory itself.
app/out/*
!app/out/flowty/
!app/out/flowty/**

# production
/build

# local env files — NEVER COMMIT
.env
.env*.local
.env.local
.env.development.local
.env.production.local

# credentials — NEVER COMMIT
creds.json
*creds*.json
*-creds.json
scripts/*creds*.json
flowty-locker-test.json
nftlocker-contract.json
nftlocker-full.json

# vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts
# Ad-hoc per-folder tsc verification configs — kept out of git
tsconfig.*.json
!tsconfig.json

# editor / IDE
.vscode/
.idea/
.cursorignore

# Claude / AI tooling — ignore local state, but track the shared session-sync hook
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/session-start.sh
!.claude/hooks/ledger-reminder.sh
.mcp.json

# Flow CLI
emulator-account.pkey
imports/
README_flow.md
flow.json
# root-only: the Flow CLI binary. A bare "flow" matched lib/chains/flow/** too
# (Phase-D-tracked code), silently un-adding new files there.
/flow

# Cadence test fixture (regenerated by scripts/extract-cadence.mjs)
tests/cadence/fixtures/purchase-moment.cdc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
Thumbs.db

supabase/.temp/

scripts/allday-moments.json
scripts/*.json

# local CSV data (wallet exports, PII) — NEVER COMMIT
scripts/data/

# local log dumps (one-off Supabase Logs API exports etc.)
logs/
*.patch

# Sentry Config File
.env.sentry-build-plugin
.env.production
sweep-*.log

# Worker package-lock.json files — workers manage their own deps inline
workers/**/package-lock.json

# one-off harvest fixtures / scratch dumps (audit 2026-05-20 - git rm --cached, then delete)
livetoken-portfolio*.json
test-gql.json
sniper.json
/Invoke-RestMethod
/main

# overnight autonomous-pass concurrency guard — transient, never commit
docs/overnight/.lock

# local-only reference docs / scratch captures kept on disk but never published
# (public repo — do not commit binary reference dumps or throwaway screenshots)
flowty-asset-inventory-doc.pdf
/_c*.png

# vitest coverage output — generated, never commit. The two gates (primary +
# components) must run into SEPARATE reportsDirectory dirs or they corrupt each
# other's coverage/.tmp, so ignore any coverage-* sibling too.
/coverage
/coverage-*

# Panini runner local capture backups (residential box only)
# Covers panini-capture* and panini-ops-capture*, incl. rotated .jsonl.1 backups
panini*capture*.jsonl*

# Playwright smoke artifacts
e2e-results.json
playwright-report/
test-results/

# Deno edge-function toolchain artifacts. `deno check --config supabase/functions/
# deno.json` (the edge-deno CI job, and any local repro of it) writes a lockfile
# beside that config. Deliberately NOT committed: CI has never validated against
# one, and adding it introduces a lock-mismatch failure mode on remote-dep drift
# for a gate that is now blocking. `supabase functions deploy` resolves deps
# independently of it.
supabase/functions/deno.lock

# `git format-patch` hand-offs from Cowork sessions that cannot push land here as
# an untracked directory at the repo ROOT (e.g. "Rip Packs City/cowork-2026-08-25/").
# Once the patches are applied their content lives in git history, so the directory
# is pure redundancy — but until someone deletes it, a `git add -A` would commit the
# patch files themselves. Ignore it rather than rely on everyone using explicit paths.
Rip Packs City/
